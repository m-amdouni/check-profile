# ============================================
# SCRAPER CONFIGURATION
# ============================================
# Scraper type: "web" for web scraping or "api" for Proxycurl API
# Note: Proxycurl API key registration has been unavailable since 2025
SCRAPER_TYPE=web

# ============================================
# WEB SCRAPER CONFIGURATION (for academic use only)
# ⚠️  WARNING: Web scraping may violate LinkedIn's Terms of Service
# ⚠️  Use at your own risk for ACADEMIC/EDUCATIONAL purposes only
# ⚠️  Limited to small sample sizes (max 20 profiles per session)
# ============================================
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Run browser in headless mode (true/false)
HEADLESS_BROWSER=true

# ============================================
# API CONFIGURATION (currently unavailable)
# Note: Proxycurl API key registration site has been down since 2025
# ============================================
# PROXYCURL_API_KEY=your_api_key_here

# ============================================
# SEARCH CONFIGURATION
# ============================================
# Default school to search (can be overridden via CLI)
TARGET_SCHOOL=Harvard University

# Maximum number of profiles to scrape per search
# For web scraping: automatically limited to 20 for ethical use
# For API scraping: can be higher but requires API credits
MAX_PROFILES=10

# Optional search keywords
SEARCH_KEYWORDS=

# ============================================
# RATE LIMITING (for API mode)
# ============================================
# Maximum API requests per minute
REQUESTS_PER_MINUTE=10

# Delay between requests in seconds
DELAY_BETWEEN_REQUESTS=6

# ============================================
# DATABASE
# ============================================
# Path to SQLite database file
DATABASE_PATH=./data/profiles.db

# ============================================
# EXPORT OPTIONS
# ============================================
# Default export format (csv, json, markdown)
EXPORT_FORMAT=csv

# Directory for exported files
EXPORT_PATH=./exports/

# ============================================
# LOGGING
# ============================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Path to log file
LOG_FILE=./logs/scraper.log
